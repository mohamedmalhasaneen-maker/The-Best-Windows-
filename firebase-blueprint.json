{
  "entities": {
    "Quote": {
      "title": "Quote",
      "description": "Saved customer quotation for The Best Windows UPVC & WPC windows and doors",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256, "description": "Unique identifier for the quote" },
        "name": { "type": "string", "minLength": 1, "maxLength": 500, "description": "Name/label of the saved quote" },
        "customer": {
          "type": "object",
          "description": "Customer info associated with the quote"
        },
        "items": {
          "type": "array",
          "description": "List of window/door quote items"
        },
        "pricingSnapshot": {
          "type": "object",
          "description": "Historical pricing snapshot of profiles and addons at quote creation time"
        },
        "totalPrice": { "type": "number", "description": "Calculated total price in EGP" },
        "discountPercentage": { "type": "number", "description": "Optional discount percentage applied" },
        "date": { "type": "string", "maxLength": 100, "description": "Formatted date string" },
        "createdAt": { "type": "string", "maxLength": 100, "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "maxLength": 100, "description": "Update ISO timestamp" },
        "serverUpdatedAt": { "type": "string", "format": "date-time", "description": "Firestore server timestamp" }
      },
      "required": ["id", "name", "customer", "items", "totalPrice"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Saved customer profile for quick access and reuse across quotes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256, "description": "Unique customer ID" },
        "name": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Customer full name" },
        "phone": { "type": "string", "maxLength": 100, "description": "Customer primary contact phone" },
        "address": { "type": "string", "maxLength": 500, "description": "Customer location or project site address" },
        "notes": { "type": "string", "maxLength": 2000, "description": "General customer notes or preferences" },
        "createdAt": { "type": "string", "maxLength": 100, "description": "Registration date timestamp" },
        "updatedAt": { "type": "string", "maxLength": 100, "description": "Last update ISO timestamp" },
        "serverUpdatedAt": { "type": "string", "format": "date-time", "description": "Firestore server timestamp" }
      },
      "required": ["id", "name", "phone"]
    },
    "PricingConfig": {
      "title": "PricingConfig",
      "description": "Shared authoritative pricing catalog of UPVC profiles and addons for all site visitors",
      "type": "object",
      "properties": {
        "profiles": {
          "type": "object",
          "description": "Map of UPVC profile definitions keyed by profile ID"
        },
        "addons": {
          "type": "object",
          "description": "Map of optional addon definitions keyed by addon ID"
        },
        "profileOrder": {
          "type": "array",
          "description": "Ordered list of profile IDs to preserve exact display order"
        },
        "addonOrder": {
          "type": "array",
          "description": "Ordered list of addon IDs to preserve exact display order"
        },
        "version": {
          "type": "number",
          "description": "Monotonically increasing revision number to prevent stale overwrites"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 100,
          "description": "ISO timestamp of the latest price update"
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Authoritative Firestore server timestamp"
        }
      },
      "required": ["profiles", "addons", "profileOrder", "addonOrder", "version", "updatedAt", "serverUpdatedAt"]
    },
    "AdminGate": {
      "title": "AdminGate",
      "description": "Write-only cryptographic authorization gate for administrator verification and pricing mutations",
      "type": "object",
      "properties": {
        "proof": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "description": "Client-derived SHA-256 hex digest verified server-side in Firestore rules"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore server timestamp proving atomic freshness"
        }
      },
      "required": ["proof", "verifiedAt"]
    }
  },
  "firestore": {
    "/quotes/{quoteId}": {
      "schema": "Quote",
      "description": "Stored quotations for The Best Windows"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Registered customer profiles directory"
    },
    "/settings/pricing": {
      "schema": "PricingConfig",
      "description": "Authoritative shared pricing catalog read by all visitors and updated only by authorized admins"
    },
    "/admin_gate/{gateId}": {
      "schema": "AdminGate",
      "description": "Write-only cryptographic admin verification gate"
    }
  }
}
